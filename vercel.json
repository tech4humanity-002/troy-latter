{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/infosys",
      "destination": "/Infosys/",
      "permanent": false
    },
    {
      "source": "/infosys/",
      "destination": "/Infosys/",
      "permanent": false
    },
    {
      "source": "/LAB3",
      "destination": "/LAB3/",
      "permanent": false
    },
    {
      "source": "/tcs",
      "destination": "/TCS/",
      "permanent": false
    },
    {
      "source": "/tcs/",
      "destination": "/TCS/",
      "permanent": false
    },
    {
      "source": "/EY-Parthenon",
      "destination": "/ey-parthenon/",
      "permanent": false
    },
    {
      "source": "/EY-Parthenon/",
      "destination": "/ey-parthenon/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/snowflake",
      "destination": "/snowflake/index.html"
    },
    {
      "source": "/ey-parthenon",
      "destination": "/ey-parthenon/index.html"
    },
    {
      "source": "/ey-parthenon/(.*)",
      "destination": "/ey-parthenon/$1"
    },
    {
      "source": "/good-things",
      "destination": "/good-things/index.html"
    },
    {
      "source": "/good-things/",
      "destination": "/good-things/index.html"
    },
    {
      "source": "/good-things/(.*)",
      "destination": "/good-things/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
